# Copy to cluster/cluster.env, locally AND in the cluster checkout. It is gitignored:
# an account name and a home path do not belong in the repository.

# --- local side (submit.sh, stage.sh, the image upload) -------------------------
CLUSTER_ALIAS=hpc                     # ssh alias of a login node; also the name of the git remote
CLUSTER_BRANCH=main                   # branch pushed to the cluster checkout
CLUSTER_USER=                         # your login
CLUSTER_TRANSFER_HOST=                # data-transfer node for the image upload (or a login node)

# --- cluster side (the .slurm scripts) -----------------------------------------
CLUSTER_BASE=/path/to/project/space   # bind-mounted into the container at the same path
CLUSTER_REPO=${CLUSTER_BASE}/code/tokenizer_v2
CLUSTER_CONTAINERS=${CLUSTER_BASE}/containers
SINGULARITY_MODULE=singularity/4.1.5
export SBATCH_ACCOUNT=                # SLURM account every job is charged to
