# Image name and version, sourced by build_image.sh and the .slurm scripts.
# Bump IMAGE_TAG whenever the Dockerfile or requirements-linux.txt changes:
# never overwrite a tag that a finished run was trained with.
IMAGE_NAME="tokenizer-v2"
IMAGE_TAG="0.2.0"
SIF_NAME="${IMAGE_NAME}_${IMAGE_TAG}.sif"
# Not gzipped: `docker save` already writes compressed layers (gzip -3 saved 0.24 %).
TAR_NAME="${IMAGE_NAME}_${IMAGE_TAG}.tar"
