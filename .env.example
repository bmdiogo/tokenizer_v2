# Every setting of the repository. Copy to `.env` and fill in the paths.
# Read once by utils/config.py; a shell variable or a KEY=VALUE argument wins over this file:
#     python -m scripts.train --exp-name t7-s1 SEED=1 DATA_SEED=11

# --- paths -------------------------------------------------------------------
DATA_PATH=/path/to/recordings                       # NS5 + NIX, one folder per patient
CACHE_DIR=/path/to/cache_v2_raw                     # <CACHE_DIR>/<patient>/<name>.npy|.npz
RUNS_DIR=runs                                       # <RUNS_DIR>/<exp-name>/: checkpoints, config, plots

# --- data (utils/cache.py, utils/dataset.py) ----------------------------------
HZ=30000
INPUT_BAND=raw                   # raw | 2,6000 (causal 4th-order Butterworth, applied when caching)
NORM_SECONDS=60                  # median / MAD of the first 60 s normalise each channel
TRAIN_PATIENTS=P2 P3             # P4 is held out: never trained on, never a statistic

# --- model (models/codec.py CONFIG) --------------------------------------------
LATENT_DIM=32                    # numbers per token, per electrode
STRIDES=8,5,3,2                  # product = samples per token (240 -> 125 Hz); append ,2 per halving
WIDTHS=32,64,128,256,512         # one more entry than STRIDES (append ,512 per extra stage)
DECODER_MULT=1.5
DILATIONS=1,3,9|1,3,9|1,3|1      # residual units per stage (append | per extra stage: no units)
ACTIVATION=elu                   # elu | gelu | none (none = the whole codec is one linear filter)
CAUSAL=1                         # 0 = the non-causal ceiling (baseline S1-N): centred padding, sees 200 ms ahead, no streaming

# --- losses (utils/losses.py CONFIG) -------------------------------------------
LAMBDA_TIME=1.0
LAMBDA_STFT=0.0                  # 0: any STFT weight keeps corr < 0.99 in the T9 overfit; 0.05 tested in S7 (C′): worse everywhere, stays 0
LAMBDA_WAVE=1.0
LAMBDA_SPK=1.0
LAMBDA_BG=0.1                    # S5 search: 1.0 keeps y_hat silent, 0.3 learns only at LR ~1e-3, 0.1 learns everywhere
MASK_ALPHA=0.25                  # edges of the spike mask m: 0 box · 0.25 Tukey · 1 Hann; ablation S7-E
MASK_SOURCE=nix                  # m from NIX Good times (nix) or from crossings on bp(x), no labels (crossings); ablation S7-D
STFT_WINDOWS_30K=64,128,512,2048
STFT_WINDOWS_1K=64,128,256

# --- training (utils/train.py CONFIG) ------------------------------------------
BURN_IN=11520                    # >= receptive field, multiple of the stride product (T2)
WINDOW=7680                      # loss span L
BATCH_SIZE=4                     # windows; x 96 electrodes = sequences per step
LR=6.07e-4                        # S5 search winner, run s5-c8 (best F1 y_hat on both val groups, +0.012 = 2 x floor)
WEIGHT_DECAY=1e-4               # S5 search winner
SCHEDULER=constant               # S5 search winner · constant | cosine | wsd (all with linear warm-up)
WARMUP_STEPS=1000
WSD_DECAY_FRAC=0.2               # wsd: the last 20 % of the steps decay to 0
MAX_STEPS=200000
EVAL_INTERVAL=1000
LOG_INTERVAL=100
SAVE_EVERY=5000                  # fixed checkpoint set: step_NNNNNN.pt
EMA_DECAY=0.999
NUM_WORKERS=4
VAL_WINDOWS=256                  # fixed validation windows, spread over every val session
MONITOR_SECONDS=10               # the fixed validation segment behind the LFP / MUA / PSD plots
SEED=42                          # model init
DATA_SEED=42                     # order of the training windows
AMP=1                            # bf16 autocast on GPU
INIT_CHECKPOINT=                  # S12-A2: start from these weights (empty = a fresh model)
FREEZE_ENCODER=0                 # S12-A2: 1 = only a fresh spike decoder trains, on the frozen tokens

# --- evaluation (utils/metrics.py, utils/sorting.py) -----------------------------
K_THRESHOLD=5.0                  # detection at -K sigma, sigma = MAD of bp(x) (T3)
VP_TAU_MS=0.5,1,5                # Victor-Purpura timescales (ms): shifting a spike further than tau costs more than dropping it
SNR_BINS=6,9,12,18               # unit SNR bin edges (peak-to-peak / sigma of bp(x)) for recall vs SNR
EVAL_SECONDS=120                 # scored part of each session
CAL_SECONDS=60                   # online sorter: templates from the first seconds (T8)
CCG_BIN_MS=0.5                   # timing between electrodes: cross-correlogram bin
CCG_WINDOW_MS=25                 # ... lags kept, +-
CCG_PEAK_MS=5                    # ... a peak is looked for within +- this lag
CCG_FLANK_MS=15                  # ... baseline = bins beyond this lag
CCG_Z=5                          # ... peak = this many Poisson SDs over the baseline
CCG_MIN_SPIKES=100               # ... both electrodes need this many detections on x
EVAL_EMA=1                       # score the EMA weights of a checkpoint (0 = the raw weights)
SWEEP_K=0.5,1,1.5,2,2.5,3,3.5,4,4.5,5   # figure data: thresholds swept for the operating-point figure

# --- weights & biases -----------------------------------------------------------
WANDB_PROJECT=tokenizer-v2
WANDB_ENTITY=
WANDB_MODE=online                # offline on the cluster (no internet on compute nodes)
WANDB_GROUP=

# --- demo app (S12-C: python -m app.precompute / app.export, then python -m app) ---
APP_CACHE_DIR=data/app/cache     # <patient>/<recording>.npy + .npz, as in the cache
APP_CHECKPOINT=data/app/runs/s8-ref-s1/step_200000.pt
APP_SHOW_DIR=data/app/show       # the bundle app.export writes and the server serves under /show/
APP_ELECTRODES=96                # the busiest electrodes first (most NIX Good spikes); 96 = the whole array
APP_CHUNK=8                      # frames per model call (8 = 64 ms steps: ~1.5x the throughput of 1)
APP_WINDOW_S=2.0                 # seconds on screen
APP_THREADS=                     # torch CPU threads (empty = torch's default)
APP_PORT=8000
